{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mathnikita",
  "main": "worker/entry.ts",
  "compatibility_date": "2026-05-22",
  "observability": {
    "enabled": true
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "secrets": {
    "required": [
      "GEMINI_API_KEY"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
