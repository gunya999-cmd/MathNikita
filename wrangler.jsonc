{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mathnikita",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-22",
  "observability": {
    "enabled": true
  },
  "secrets": {
    "required": ["GEMINI_API_KEY"]
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
